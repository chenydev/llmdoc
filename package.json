{
  "name": "@tokenroll/llmdoc-repository",
  "version": "4.0.0",
  "private": true,
  "description": "Development workspace for the llmdoc CLI and Claude/Codex/Antigravity plugin surfaces",
  "scripts": {
    "build": "npm --prefix cli run build",
    "build:agy": "node scripts/build-agy-plugin.mjs",
    "install:agy": "node scripts/install-agy-plugin.mjs",
    "sync:surfaces": "node scripts/sync-surfaces.mjs",
    "check:surfaces": "node scripts/check-codex-surface.mjs",
    "lint": "npm --prefix cli run lint",
    "test": "npm --prefix cli test",
    "typecheck": "npm --prefix cli run typecheck",
    "validate:dogfood": "node cli/dist/bin/llmdoc.js validate",
    "check:prompts": "node scripts/check-prompt-budget.mjs"
  },
  "devDependencies": {
    "@tokenroll/llmdoc": "file:cli",
    "gray-matter": "^4.0.3"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
